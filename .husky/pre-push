#!/usr/bin/env bash
# Pre-Push Hook: Git Safety & Protected Branch Guard
# Validates branch naming, then prevents force pushes and direct pushes to main.
# Bypass with: ALLOW_DANGEROUS_GIT=1 git push ...

set -eu

if [ "${ALLOW_DANGEROUS_GIT:-0}" = "1" ] || [ -n "${JULES_SESSION_ID:-}" ]; then
  exit 0
fi

# Branch naming convention (AGENTS.md section 15). The ADR 0037 and ADR 0049
# workflows both assume prefixed short-lived branches cut from main.
npx tsx scripts/validate-branch.ts

# Read pushed refs from stdin
# Format: <local ref> <local sha1> <remote ref> <remote sha1>
while read -r local_ref local_sha remote_ref remote_sha; do
  # Check if pushing directly to main
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "BLOCKED: Direct push to 'main' branch is prohibited." >&2
    echo "Active development must occur on feature branches and merge through pull requests." >&2
    echo "To bypass in an emergency, set ALLOW_DANGEROUS_GIT=1 before pushing." >&2
    exit 1
  fi
done

exit 0
