{
  "name": "fderuiter-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dx": "npx tsx scripts/dx.ts",
    "crf": "npx tsx scripts/crf.ts",
    "setup": "npx tsx scripts/dx.ts setup",
    "setup:clerk": "./scripts/setup-clerk-wizard.sh",
    "doctor": "npx tsx scripts/dx.ts doctor",
    "doctor:fix": "npx tsx scripts/dx.ts doctor --fix",
    "verify": "npx tsx scripts/dx.ts verify",
    "commit": "npx tsx scripts/dx.ts commit",
    "env:check": "npx tsx scripts/dx.ts env",
    "dead-code": "npx tsx scripts/dx.ts dead-code",
    "analyze:bundle": "npx tsx scripts/dx.ts analyze",
    "bench": "npx tsx scripts/dx.ts bench",
    "bench:pages": "npx tsx scripts/benchmark-pages.ts",
    "scaffold": "npx tsx scripts/dx.ts scaffold",
    "quality": "npm run check && npm run lint:docs && npm run check-docs-drift && npm run bench:pages -- --assert && npm run verify",
    "predev": "npx tsx scripts/generate-theme.ts",
    "dev": "concurrently -n \"turbo,tsc\" -c \"cyan,magenta\" \"next dev --turbo\" \"tsc --noEmit --watch\"",
    "build:icons": "npx tsx scripts/generate-brand-icons.ts",
    "build:theme": "npx tsx scripts/generate-theme.ts",
    "generate:icons": "npx tsx scripts/generate-brand-icons.ts",
    "generate:theme": "npx tsx scripts/generate-theme.ts",
    "precompile-docs": "npx prisma generate",
    "compile-docs": "npx typedoc --entryPoints hooks --entryPoints types --entryPoints lib --exclude \"**/env.d.ts\" --entryPointStrategy expand --out docs --plugin typedoc-plugin-markdown --hideGenerator --cleanOutputDir false --gitRevision main --sourceLinkTemplate \"https://github.com/fderuiter/portfolio/blob/{gitRevision}/{path}#L{line}\" --intentionallyNotExported TypeMap --intentionallyNotExported GlobalOmitConfig --intentionallyNotExported TypeMapCb",
    "check-docs-drift": "npx tsx scripts/check-drift.ts",
    "check:migrations": "node scripts/check-migrations.js",
    "check:migrations:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "release:gate": "npx tsx scripts/release-gate.ts",
    "lint:docs": "npx markdownlint \"**/*.md\" --ignore node_modules --ignore .next --ignore coverage --ignore .agents --ignore scratch --ignore tmp --ignore test-results",
    "prebuild": "npx tsx scripts/generate-theme.ts",
    "build": "node scripts/build.js",
    "start": "next start",
    "lint": "eslint --no-warn-ignored",
    "check": "tsc --noEmit && npm run lint",
    "prepare": "husky",
    "preinstall": "node scripts/enforce-npm.js",
    "pretest": "npx tsx scripts/generate-theme.ts && npx prisma generate",
    "test": "VITE_CONFIG_NATIVE_IGNORE_WARNING=1 vitest run",
    "test:ci": "VITE_CONFIG_NATIVE_IGNORE_WARNING=1 vitest run --coverage",
    "test:coverage": "VITE_CONFIG_NATIVE_IGNORE_WARNING=1 vitest run --coverage",
    "test:watch": "VITE_CONFIG_NATIVE_IGNORE_WARNING=1 vitest",
    "test:fuzz": "VITE_CONFIG_NATIVE_IGNORE_WARNING=1 vitest run __tests__/property-fuzz.test.ts",
    "test:mutation": "npx tsx scripts/run-mutation-tests.ts",
    "audit:security": "npx tsx scripts/security-audit.ts",
    "probe:synthetic": "playwright test __tests__/e2e/synthetic-probes.spec.ts",
    "canary:eval": "npx tsx scripts/canary-analyzer.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "typedoc": {
      "brace-expansion": "^5.0.8"
    },
    "deepmerge-ts": "^8.0.1",
    "fast-uri": "^3.0.1",
    "ip-address": "^9.0.5",
    "shell-quote": "^1.8.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored"
    ],
    "*.{ts,tsx}": [
      "vitest related --run --passWithNoTests"
    ]
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@clerk/nextjs": "^7.7.8",
    "@clerk/themes": "^2.4.57",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.55.0",
    "@serwist/next": "^9.5.12",
    "@serwist/sw": "^9.5.12",
    "@tabler/icons-react": "^3.41.1",
    "@types/three": "^0.185.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "framer-motion": "^12.38.0",
    "isomorphic-dompurify": "^3.22.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.4",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.5",
    "markdownlint-cli": "^0.49.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
