{
  "name": "temp_dir",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npx tsx scripts/generate-theme.ts",
    "dev": "concurrently -n \"turbo,tsc\" -c \"cyan,magenta\" \"next dev --turbo\" \"tsc --noEmit --watch\"",
    "prebuild": "npx tsx scripts/generate-theme.ts",
    "build": "node scripts/check-migrations.js && npx prisma generate && npx prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "check": "tsc --noEmit && npm run lint"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@tabler/icons-react": "^3.41.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "isomorphic-dompurify": "^3.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
