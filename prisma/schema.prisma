// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CaseStudy {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  title                   String
  primary_language        String
  github_url              String?
  editorial_content       String   // Stores general descriptions
  architectural_narrative String   // Stores deep-dive technical explanations
  published               Boolean  @default(false)
  simulated_telemetry     Boolean  @default(false)
  tags                    String   // Comma-separated string or a related Tag model
  commands_json           String?
  playback_json           String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
}

model TelemetryEvent {
  id          String   @id @default(cuid())
  projectSlug String
  eventType   String   // "page_view" | "project_click"
  createdAt   DateTime @default(now())

  @@index([projectSlug])
  @@index([eventType])
}

model TelemetryDailyRollup {
  day         DateTime @db.Date
  projectSlug String
  eventType   String
  count       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([day, projectSlug, eventType])
  @@index([day])
}

model CaseStudyFeedback {
  id             String   @id @default(cuid())
  caseStudySlug  String
  takeaways      String
  comments       String
  connectionHash String
  createdAt      DateTime @default(now())

  @@index([caseStudySlug])
  @@index([connectionHash])
}

model CaseStudyReaction {
  id             String   @id @default(cuid())
  caseStudySlug  String
  reactionType   String
  connectionHash String
  createdAt      DateTime @default(now())

  @@index([caseStudySlug])
  @@index([caseStudySlug, reactionType])
  @@index([connectionHash])
}

enum SuppressionReason {
  BOUNCE
  COMPLAINT
  UNSUBSCRIBE
}

enum OutboundEmailStatus {
  PENDING
  RETRYING
  DELIVERED
  FAILED
}

model SuppressionList {
  id        String            @id @default(cuid())
  email     String            @unique
  reason    SuppressionReason
  createdAt DateTime          @default(now())
}

model OutboundEmailQueue {
  id          String              @id @default(cuid())
  to          String
  from        String
  replyTo     String?
  subject     String
  html        String              @db.Text
  text        String?             @db.Text
  tags        Json?
  attempts    Int                 @default(0)
  status      OutboundEmailStatus @default(PENDING)
  nextRetryAt DateTime            @default(now())
  lastError   String?             @db.Text
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, nextRetryAt])
  @@index([createdAt])
}
